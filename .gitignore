*.bak

# ── 4. 실행·빌드 산출물 ────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
# 과정 사이트(MkDocs) 빌드 산출물 — 배포는 GitHub Actions가 새로 만든다(USB용 오프라인판 site_offline/ 포함)
site/
site_offline/
# tools/sync_site_assets.py가 data/day1·labs/day1에서 복사해 만드는 배포용 사본(원본은 data/·labs/에 있다)
docs/downloads/
# Challenge 노트북을 로컬에서 돌리면 실행한 폴더에 생기는 SEC 응답 캐시(labs/day1/sec_cache/ 등 — 어느 폴더든 뺀다)
sec_cache/
# 브라우저 점검 도구 기록
.gstack/

# 수강생용 슬라이드 PDF(D18): 당일 18:00에 `git add -f handouts/dayN_slides.pdf`로 공개
handouts/

# K-SURE 약관 본문·발췌는 재배포 금지 — 저장소에 넣지 않는다(D36). 공식 링크는 rag/corpus/README.md
rag/corpus/*ksure*
rag/corpus/*약관*
*ksure_terms*

# ── 5. 수강생 작업 환경 ────────────────────────────────────────────
# Claude Code worktree(`claude --worktree 이름`)가 브랜치마다 펼치는 작업 폴더 — 사본이라 커밋하지 않는다
.claude/worktrees/
# tools/get_day_files.py가 받다가 멈춘 임시 파일
*.part
