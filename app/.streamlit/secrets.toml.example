# 이 파일을 복사해 쓰는 법(키 값은 저장소에 절대 올리지 않는다)
#  - 로컬: app/.streamlit/secrets.toml 로 복사해 값을 채운다(.gitignore가 막는다)
#  - Community Cloud: 앱 → Settings → Secrets 칸에 아래 내용을 붙여 넣는다
# [llm] 칸을 비워 두거나 자리표시(<…>) 그대로 두면 앱은 모의 모드(템플릿 초안·검색 결과 인용)로 돈다.

[llm]
base_url = "https://<강사 LiteLLM 주소>/v1"   # LiteLLM 프록시(OpenAI 호환) — Day5 09:00 키 카드에 적힌 주소
api_key = "<내 가상 키>"                       # 개인 가상 키: 일 $3 · 분당 30회 · 10/22 만료
default_model = "fast-default"
fallback_models = ["fast-backup"]              # 수강생 키는 fast-* 별칭만 쓸 수 있다

[app]
learner_id = "L07"                             # 키 카드 번호(감사로그 learner_id)
approver_name = "홍길동"                        # ⑤ 승인자 기본값
recipient_whitelist = ["^myname\\+B\\d{3}@gmail\\.com$", "buyer+*@example.com"]   # 초안 수신자 허용 패턴(정규식 ^… 또는 와일드카드)
send_tz = "Asia/Seoul"                         # 발송 시간창 시간대 — 수업: 수신자 = 본인(한국). 실무: 바이어 현지
# demo_clock = "2026-10-20 15:00"              # (선택) 밤에 리허설할 때 발송 시간창 검사에 쓸 시각(한국 시각)
# company_name = "Hanbit Precision Co., Ltd. (fictional)"
# sender_name = "Credit Team"
